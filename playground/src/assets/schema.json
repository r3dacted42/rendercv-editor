    "email": {
      "default": null,
      "description": "You can provide multiple emails as a list.",
      "examples": [
        "john.doe@example.com",
        ["john.doe.1@example.com", "john.doe.2@example.com"]
      ],
      "title": "Email"
    },
    "photo": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
