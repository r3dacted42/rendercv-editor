{
  "name": "rendercv-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "scripts": {
    "build:lib": "npm run build -w @r3dacted42/rendercv-form",
    "dev:lib": "npm run dev -w @r3dacted42/rendercv-form",
    "dev": "npm run build:lib && npm run dev -w playground",
    "build": "npm run build:lib && npm run build -w playground",
    "preview": "npm run preview -w playground"
  }
}
